# ==========================================
# EventBlast - WhatsApp Event Marketing SaaS
# Environment Variables Configuration
# ==========================================

# Node Environment
NODE_ENV=development
PORT=4000
WORKER_PORT=4001
WEB_PORT=3000

# Application URLs
APP_URL=http://localhost:3000
API_URL=http://localhost:4000

# Database (PostgreSQL)
DATABASE_URL=postgresql://eventblast:eventblast_secret@localhost:5432/eventblast_db?schema=public

# Redis (Job Queue & Caching)
REDIS_URL=redis://localhost:6379

# Authentication & Security
JWT_SECRET=super_secret_jwt_key_change_in_production_min_32_chars_long!
JWT_EXPIRES_IN=7d
ENCRYPTION_KEY=super_secret_encryption_key_32bytes_min!

# WhatsApp Gateway (OpenWA)
WHATSAPP_PROVIDER=mock # Options: 'openwa', 'mock', 'meta'
OPENWA_BASE_URL=http://localhost:2785
OPENWA_API_KEY=your_openwa_api_secret_key
OPENWA_WEBHOOK_SECRET=your_openwa_webhook_secret_key
OPENWA_TIMEOUT_MS=15000

# Campaign Throttling & Safety Controls
MESSAGE_MIN_DELAY_MS=1000
MESSAGE_MAX_DELAY_MS=3000
MAX_MESSAGES_PER_MINUTE=60
MAX_RETRIES=3
RETRY_DELAY_MS=5000

# Object Storage (S3 / Cloudflare R2 / Local)
STORAGE_PROVIDER=local # Options: 'local', 's3'
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_BUCKET=eventblast-media
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
STORAGE_PUBLIC_URL=http://localhost:4000/uploads

# System Admin Seed Configuration
INITIAL_ADMIN_EMAIL=admin@eventblast.io
INITIAL_ADMIN_PASSWORD=AdminPassword123!
INITIAL_ORG_NAME=Global Events Corp
INITIAL_ORG_SLUG=global-events
