FROM node:20-alpine AS builder

RUN apk add --no-cache openssl libc6-compat git

WORKDIR /app

COPY package.json package-lock.json* ./
COPY packages/ ./packages/
COPY apps/api/ ./apps/api/
COPY tsconfig.base.json ./

RUN npm install
RUN npm --workspace=packages/database run generate
RUN npm --workspace=packages/types run build
RUN npm --workspace=packages/shared run build
RUN npm --workspace=packages/validation run build
RUN npm --workspace=packages/whatsapp run build
RUN npm --workspace=packages/database run build
RUN npm --workspace=apps/api run build

FROM node:20-alpine AS runner

RUN apk add --no-cache openssl libc6-compat

WORKDIR /app

ENV NODE_ENV=production

COPY --from=builder /app/package.json ./
COPY --from=builder /app/tsconfig.base.json ./
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/packages ./packages
COPY --from=builder /app/apps/api/dist ./apps/api/dist
COPY --from=builder /app/apps/api/package.json ./apps/api/package.json

EXPOSE 4000

CMD ["node", "apps/api/dist/main"]
