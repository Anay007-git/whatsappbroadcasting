datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x", "linux-musl"]
}

enum Role {
  OWNER
  ADMIN
  MANAGER
  OPERATOR
  VIEWER
}

enum UserStatus {
  ACTIVE
  INACTIVE
  INVITED
}

enum WhatsAppSessionStatus {
  INITIALIZING
  QR_READY
  CONNECTED
  DISCONNECTED
  FAILED
}

enum WhatsAppProviderType {
  OPENWA
  MOCK
  META_CLOUD
}

enum EventStatus {
  DRAFT
  PUBLISHED
  LIVE
  COMPLETED
  CANCELLED
  ARCHIVED
}

enum RSVPStatus {
  PENDING
  GOING
  MAYBE
  DECLINED
}

enum InvitationStatus {
  NOT_SENT
  QUEUED
  SENT
  DELIVERED
  READ
  FAILED
}

enum CampaignType {
  INVITATION
  REMINDER
  CONFIRMATION
  FOLLOW_UP
  ANNOUNCEMENT
  CUSTOM
}

enum CampaignStatus {
  DRAFT
  SCHEDULED
  RUNNING
  PAUSED
  COMPLETED
  CANCELLED
  FAILED
}

enum CampaignMessageStatus {
  QUEUED
  SENDING
  SENT
  DELIVERED
  READ
  FAILED
}

enum MediaType {
  IMAGE
  VIDEO
  DOCUMENT
  AUDIO
}

enum AuditAction {
  LOGIN
  LOGOUT
  USER_INVITE
  USER_UPDATE
  CONTACT_CREATE
  CONTACT_UPDATE
  CONTACT_DELETE
  CONTACT_IMPORT
  CONTACT_EXPORT
  GROUP_CREATE
  GROUP_UPDATE
  GROUP_DELETE
  SUPPRESSION_ADD
  SUPPRESSION_REMOVE
  EVENT_CREATE
  EVENT_UPDATE
  EVENT_DELETE
  CAMPAIGN_CREATE
  CAMPAIGN_UPDATE
  CAMPAIGN_LAUNCH
  CAMPAIGN_PAUSE
  CAMPAIGN_RESUME
  CAMPAIGN_CANCEL
  CAMPAIGN_EMERGENCY_STOP
  CAMPAIGN_TEST_SEND
  WHATSAPP_CONNECT
  WHATSAPP_DISCONNECT
  SETTINGS_CHANGE
}

model Organization {
  id               String            @id @default(uuid())
  name             String
  slug             String            @unique
  logoUrl          String?
  timezone         String            @default("Asia/Kolkata")
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  users            User[]
  whatsappSessions WhatsAppSession[]
  contacts         Contact[]
  contactGroups    ContactGroup[]
  suppressions     SuppressionEntry[]
  events           Event[]
  templates        Template[]
  campaigns        Campaign[]
  media            Media[]
  auditLogs        AuditLog[]
  automationRules  AutomationRule[]

  @@map("organizations")
}

model User {
  id             String       @id @default(uuid())
  organizationId String
  name           String
  email          String       @unique
  passwordHash   String
  role           Role         @default(OPERATOR)
  status         UserStatus   @default(ACTIVE)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  auditLogs      AuditLog[]

  @@index([organizationId])
  @@map("users")
}

model WhatsAppSession {
  id                      String                @id @default(uuid())
  organizationId          String
  provider                WhatsAppProviderType  @default(MOCK)
  providerSessionId       String                @unique
  phoneNumber             String?
  displayName             String
  status                  WhatsAppSessionStatus @default(INITIALIZING)
  qrCode                  String?               @db.Text
  lastSeenAt              DateTime?
  lastSuccessfulMessageAt DateTime?
  failureCount            Int                   @default(0)
  createdAt               DateTime              @default(now())
  updatedAt               DateTime              @updatedAt

  organization            Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  campaigns               Campaign[]

  @@index([organizationId])
  @@map("whatsapp_sessions")
}

model Contact {
  id             String               @id @default(uuid())
  organizationId String
  firstName      String
  lastName       String?
  fullName       String
  phoneNumber    String               // E.164 normalized (+919876543210)
  email          String?
  company        String?
  designation    String?
  source         String               @default("MANUAL")
  marketingOptIn Boolean              @default(true)
  optInSource    String?              @default("DIRECT")
  optInAt        DateTime?            @default(now())
  optedOut       Boolean              @default(false)
  optedOutAt     DateTime?
  customFields   Json?                @default("{}")
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  organization   Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  groupMembers   ContactGroupMember[]
  eventGuests    EventGuest[]
  campaignMessages CampaignMessage[]

  @@unique([organizationId, phoneNumber])
  @@index([organizationId])
  @@index([phoneNumber])
  @@map("contacts")
}

model ContactGroup {
  id             String               @id @default(uuid())
  organizationId String
  name           String
  description    String?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  organization   Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  members        ContactGroupMember[]

  @@unique([organizationId, name])
  @@index([organizationId])
  @@map("contact_groups")
}

model ContactGroupMember {
  id        String       @id @default(uuid())
  groupId   String
  contactId String
  addedAt   DateTime     @default(now())

  group     ContactGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  contact   Contact      @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@unique([groupId, contactId])
  @@index([groupId])
  @@index([contactId])
  @@map("contact_group_members")
}

model SuppressionEntry {
  id             String       @id @default(uuid())
  organizationId String
  phoneNumber    String
  reason         String
  source         String       @default("MANUAL")
  createdAt      DateTime     @default(now())

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, phoneNumber])
  @@index([organizationId])
  @@index([phoneNumber])
  @@map("suppression_entries")
}

model Event {
  id              String            @id @default(uuid())
  organizationId  String
  name            String
  slug            String
  description     String?           @db.Text
  bannerUrl       String?
  startAt         DateTime
  endAt           DateTime
  timezone        String            @default("Asia/Kolkata")
  venueName       String
  venueAddress    String
  latitude        Float?
  longitude       Float?
  mapsUrl         String?
  rsvpEnabled     Boolean           @default(true)
  rsvpDeadline    DateTime?
  status          EventStatus       @default(PUBLISHED)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  organization    Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  guests          EventGuest[]
  campaigns       Campaign[]
  automationRules AutomationRule[]

  @@unique([organizationId, slug])
  @@index([organizationId])
  @@map("events")
}

model EventGuest {
  id               String           @id @default(uuid())
  eventId          String
  contactId        String
  invitationStatus InvitationStatus @default(NOT_SENT)
  rsvpStatus       RSVPStatus       @default(PENDING)
  uniqueToken      String           @unique
  guestCount       Int              @default(1)
  notes            String?
  invitedAt        DateTime?
  respondedAt      DateTime?
  checkedInAt      DateTime?
  customData       Json?            @default("{}")
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  event            Event            @relation(fields: [eventId], references: [id], onDelete: Cascade)
  contact          Contact          @relation(fields: [contactId], references: [id], onDelete: Cascade)
  campaignMessages CampaignMessage[]

  @@unique([eventId, contactId])
  @@index([uniqueToken])
  @@index([eventId])
  @@index([contactId])
  @@map("event_guests")
}

model Template {
  id             String       @id @default(uuid())
  organizationId String
  name           String
  content        String       @db.Text
  category       String       @default("MARKETING")
  mediaUrl       String?
  mediaType      MediaType?
  variables      Json?        @default("[]")
  isArchived     Boolean      @default(false)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  campaigns      Campaign[]
  automationRules AutomationRule[]

  @@index([organizationId])
  @@map("templates")
}

model Campaign {
  id                String            @id @default(uuid())
  organizationId    String
  eventId           String?
  name              String
  description       String?
  campaignType      CampaignType      @default(INVITATION)
  status            CampaignStatus    @default(DRAFT)
  whatsappSessionId String
  templateId        String?
  messageContent    String            @db.Text
  mediaUrl          String?
  mediaType         MediaType?
  targetAudience    Json              @default("{}")
  scheduledAt       DateTime?
  startedAt         DateTime?
  completedAt       DateTime?
  createdBy         String
  totalRecipients   Int               @default(0)
  sentCount         Int               @default(0)
  deliveredCount    Int               @default(0)
  readCount         Int               @default(0)
  failedCount       Int               @default(0)
  rsvpCount         Int               @default(0)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  organization      Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  event             Event?            @relation(fields: [eventId], references: [id], onDelete: SetNull)
  whatsappSession   WhatsAppSession   @relation(fields: [whatsappSessionId], references: [id], onDelete: Restrict)
  template          Template?         @relation(fields: [templateId], references: [id], onDelete: SetNull)
  messages          CampaignMessage[]

  @@index([organizationId])
  @@index([status])
  @@index([eventId])
  @@map("campaigns")
}

model CampaignMessage {
  id                String                @id @default(uuid())
  campaignId        String
  contactId         String
  eventGuestId      String?
  sessionId         String
  renderedMessage   String                @db.Text
  mediaUrl          String?
  mediaType         MediaType?
  providerMessageId String?
  status            CampaignMessageStatus @default(QUEUED)
  attemptCount      Int                   @default(0)
  maxAttempts       Int                   @default(3)
  nextAttemptAt     DateTime?
  sentAt            DateTime?
  deliveredAt       DateTime?
  readAt            DateTime?
  failedAt          DateTime?
  failureReason     String?
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt

  campaign          Campaign              @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  contact           Contact               @relation(fields: [contactId], references: [id], onDelete: Cascade)
  eventGuest        EventGuest?           @relation(fields: [eventGuestId], references: [id], onDelete: SetNull)

  @@unique([campaignId, contactId])
  @@index([campaignId])
  @@index([status])
  @@index([providerMessageId])
  @@map("campaign_messages")
}

model AutomationRule {
  id                 String            @id @default(uuid())
  organizationId     String
  eventId            String
  triggerType        String            @default("HOURS_BEFORE_START")
  triggerOffsetHours Int               @default(24)
  conditionFilter    Json              @default("{}")
  actionType         String            @default("SEND_REMINDER_CAMPAIGN")
  templateId         String?
  isActive           Boolean           @default(true)
  lastTriggeredAt    DateTime?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  organization       Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  event              Event             @relation(fields: [eventId], references: [id], onDelete: Cascade)
  template           Template?         @relation(fields: [templateId], references: [id], onDelete: SetNull)
  executions         AutomationExecution[]

  @@index([organizationId])
  @@index([eventId])
  @@map("automation_rules")
}

model AutomationExecution {
  id          String         @id @default(uuid())
  ruleId      String
  eventId     String
  contactId   String
  status      String         @default("COMPLETED")
  executedAt  DateTime       @default(now())
  result      Json?          @default("{}")

  rule        AutomationRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)

  @@index([ruleId])
  @@map("automation_executions")
}

model Media {
  id             String       @id @default(uuid())
  organizationId String
  filename       String
  mimeType       String
  size           Int
  storageKey     String
  url            String
  createdAt      DateTime     @default(now())

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@map("media")
}

model AuditLog {
  id             String       @id @default(uuid())
  organizationId String
  userId         String?
  action         AuditAction
  resourceType   String
  resourceId     String?
  metadata       Json?        @default("{}")
  ipAddress      String?
  userAgent      String?
  createdAt      DateTime     @default(now())

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([action])
  @@map("audit_logs")
}
