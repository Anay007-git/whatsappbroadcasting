# ==============================================================================
# EventBlast Enterprise - Production Environment Configuration Template
# ==============================================================================

# Application URLs
APP_URL=https://your-eventblast-app.vercel.app
API_URL=https://api.yourdomain.com
NEXT_PUBLIC_API_URL=https://api.yourdomain.com/api

# Database & Redis Credentials
POSTGRES_USER=eventblast
POSTGRES_PASSWORD=replace_with_strong_random_password_32_chars_min
POSTGRES_DB=eventblast_db
DATABASE_URL=postgresql://eventblast:replace_with_strong_random_password_32_chars_min@postgres:5432/eventblast_db?schema=public
REDIS_URL=redis://redis:6379

# Security & Secrets
JWT_SECRET=super_secure_jwt_token_secret_key_minimum_64_characters_long_for_prod!

# WhatsApp Gateway Provider (Default: openwa for Baileys Multi-Device)
WHATSAPP_PROVIDER=openwa

# Campaign Dispatcher Settings
MESSAGE_MIN_DELAY_MS=1500
